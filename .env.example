# ==============================================================================
# Indigenous Component Dependency & Alternative Intelligence Platform
# Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL for Docker, SQLite for standalone local run)
DATABASE_URL=sqlite:///./indigenous_platform.db
# For Docker or local PostgreSQL:
# DATABASE_URL=postgresql://indicomp_user:indicomp_password@localhost:5432/indicomp_db

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=indicomp_user
POSTGRES_PASSWORD=indicomp_password_change_me_in_production
POSTGRES_DB=indicomp_db

# Application Configuration
ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=10

# Optional Feature Flags
ENABLE_SEMANTIC_SEARCH=false
ENABLE_LLM_EXPLAINER=false

# Optional Local Reasoning Model (Ollama)
LLM_PROVIDER=ollama
LLM_API_BASE=http://localhost:11434
LLM_MODEL=llama3

# Optional External Data Sources (Leave blank to use local curated catalogue)
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Frontend API URL
VITE_API_BASE=http://localhost:8000/api
